<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Water Dispenser — Live Demo</title>
  <style>
    :root {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --accent: #db2777;
      --cold: #0284c7;
      --hot: #ef4444;
      --ambient: #10b981;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --radius: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding-bottom: 60px; }

    /* Top Bar */
    .demo-bar {
      background: var(--text);
      color: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }
    .demo-bar .badge { background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 4px; font-weight: bold; }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-size: 1.4rem; font-weight: 800; color: var(--primary); text-decoration: none; }
    .brand span { color: var(--accent); }

    .nav-tabs { display: flex; gap: 8px; }
    .nav-tab {
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: transparent;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: 0.2s;
    }
    .nav-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

    /* Main Container */
    .container { max-width: 1100px; margin: 24px auto; padding: 0 16px; }

    /* Views */
    .view-section { display: none; }
    .view-section.active { display: block; }

    /* Dispenser Grid */
    .dispenser-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 24px;
    }
    @media (max-width: 768px) {
      .dispenser-layout { grid-template-columns: 1fr; }
    }

    /* Water Jug Visual */
    .jug-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      text-align: center;
    }
    .jug-container {
      width: 160px;
      height: 260px;
      border: 4px solid #cbd5e1;
      border-radius: 20px 20px 10px 10px;
      margin: 20px auto;
      position: relative;
      overflow: hidden;
      background: #f1f5f9;
    }
    .water-fill {
      position: absolute;
      bottom: 0;
      width: 100%;
      height: 80%;
      background: linear-gradient(180deg, #38bdf8 0%, #0284c7 100%);
      transition: height 0.5s ease;
    }
    .water-level-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-weight: 800;
      font-size: 1.5rem;
      color: #fff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
      z-index: 10;
    }

    /* Control Panel */
    .controls-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
    }

    .temp-selector {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }
    .temp-btn {
      padding: 16px;
      border-radius: 8px;
      border: 2px solid var(--border);
      background: var(--surface);
      cursor: pointer;
      font-weight: 700;
      text-align: center;
      transition: 0.2s;
    }
    .temp-btn.cold.active { border-color: var(--cold); background: #e0f2fe; color: var(--cold); }
    .temp-btn.ambient.active { border-color: var(--ambient); background: #d1fae5; color: var(--ambient); }
    .temp-btn.hot.active { border-color: var(--hot); background: #fee2e2; color: var(--hot); }

    .preset-btns {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
    }
    .preset-btn {
      flex: 1;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #f8fafc;
      font-weight: 600;
      cursor: pointer;
    }
    .preset-btn:hover { background: #e2e8f0; }

    .dispense-main-btn {
      width: 100%;
      padding: 20px;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 1.2rem;
      font-weight: 800;
      cursor: pointer;
      transition: 0.2s;
    }
    .dispense-main-btn:disabled { background: #cbd5e1; cursor: not-allowed; }

    /* Admin Dashboard */
    .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: var(--surface); padding: 16px; border-radius: var(--radius); border: 1px solid var(--border); }
    .stat-card h4 { font-size: 0.85rem; color: var(--muted); }
    .stat-card p { font-size: 1.5rem; font-weight: 800; color: var(--primary); margin-top: 4px; }

    .log-table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
    .log-table th, .log-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); }
    .log-table th { background: #f8fafc; font-size: 0.85rem; color: var(--muted); }
  </style>
</head>
<body>

  <div class="demo-bar">
    <div><strong>Smart Water Dispenser</strong> — Live Interactive Demo</div>
    <div><span class="badge">BSIT PORTFOLIO PROJECT</span></div>
  </div>

  <header>
    <div class="header-container">
      <a href="#" class="brand">AquaMonitor<span>.</span></a>
      <div class="nav-tabs">
        <button class="nav-tab active" onclick="switchView('dispenser')">Dispenser Station</button>
        <button class="nav-tab" onclick="switchView('admin')">Admin & Maintenance</button>
      </div>
    </div>
  </header>

  <div class="container">
    <!-- DISPENSER STATION VIEW -->
    <section id="dispenserView" class="view-section active">
      <div class="dispenser-layout">
        <div class="jug-card">
          <h3>Gallon Level</h3>
          <p style="font-size: 0.8rem; color: var(--muted);">5 Gallon Capacity (19 Liters)</p>
          
          <div class="jug-container">
            <div class="water-level-text" id="waterPercent">80%</div>
            <div class="water-fill" id="waterFill"></div>
          </div>

          <p id="waterVolumeText" style="font-weight: 700; margin-bottom: 12px;">15.2 Liters remaining</p>
          <button onclick="requestRefill()" style="width: 100%; padding: 10px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">🔄 Replace / Refill Gallon</button>
        </div>

        <div class="controls-card">
          <h3 style="margin-bottom: 16px;">Water Selection</h3>
          
          <div class="temp-selector">
            <div class="temp-btn cold active" onclick="selectTemp('Cold', this)">
              ❄️ Cold<br><small>5°C</small>
            </div>
            <div class="temp-btn ambient" onclick="selectTemp('Ambient', this)">
              💧 Ambient<br><small>25°C</small>
            </div>
            <div class="temp-btn hot" onclick="selectTemp('Hot', this)">
              🔥 Hot<br><small>85°C</small>
            </div>
          </div>

          <h4 style="margin-bottom: 12px; color: var(--muted);">Select Volume Preset</h4>
          <div class="preset-btns">
            <button class="preset-btn" onclick="dispenseWater(250)">Glass (250ml)</button>
            <button class="preset-btn" onclick="dispenseWater(500)">Tumbler (500ml)</button>
            <button class="preset-btn" onclick="dispenseWater(1000)">Jug (1000ml)</button>
          </div>

          <button class="dispense-main-btn" id="dispenseBtn" onclick="dispenseWater(250)">Dispense Water (250ml)</button>
        </div>
      </div>
    </section>

    <!-- ADMIN VIEW -->
    <section id="adminView" class="view-section">
      <div class="dash-stats">
        <div class="stat-card">
          <h4>Total Dispensed Today</h4>
          <p id="totalDispensedText">3.80 L</p>
        </div>
        <div class="stat-card">
          <h4>Filter Health</h4>
          <p style="color: #10b981;">92% (Good)</p>
        </div>
        <div class="stat-card">
          <h4>Refill Requests Logged</h4>
          <p id="refillCountText">1</p>
        </div>
      </div>

      <h3 style="margin-bottom: 12px;">Recent Dispense Logs</h3>
      <table class="log-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Type</th>
            <th>Volume</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="logTable">
          <tr>
            <td>10:15 AM</td>
            <td>Cold (5°C)</td>
            <td>250 ml</td>
            <td><span style="color: #10b981; font-weight:bold;">Completed</span></td>
          </tr>
        </tbody>
      </table>
    </section>
  </div>

  <script>
    let currentVolume = 15.2; // in liters
    const maxVolume = 19.0;
    let selectedTemp = "Cold";
    let selectedPreset = 250;
    let totalDispensedToday = 3.8;
    let refillCount = 1;

    function updateWaterUI() {
      const percentage = Math.max(0, Math.round((currentVolume / maxVolume) * 100));
      document.getElementById("waterPercent").innerText = percentage + "%";
      document.getElementById("waterFill").style.height = percentage + "%";
      document.getElementById("waterVolumeText").innerText = `${currentVolume.toFixed(2)} Liters remaining`;

      const dispenseBtn = document.getElementById("dispenseBtn");
      if (currentVolume <= 0) {
        dispenseBtn.disabled = true;
        dispenseBtn.innerText = "Gallon Empty - Refill Required";
      } else {
        dispenseBtn.disabled = false;
        dispenseBtn.innerText = `Dispense ${selectedTemp} Water (${selectedPreset}ml)`;
      }
    }

    function selectTemp(temp, element) {
      selectedTemp = temp;
      document.querySelectorAll('.temp-btn').forEach(btn => btn.classList.remove('active'));
      element.classList.add('active');
      updateWaterUI();
    }

    function dispenseWater(ml) {
      selectedPreset = ml;
      const litersToDispense = ml / 1000;

      if (currentVolume >= litersToDispense) {
        currentVolume -= litersToDispense;
        totalDispensedToday += litersToDispense;

        // Log transaction
        const now = new Date();
        const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const tbody = document.getElementById("logTable");
        tbody.innerHTML = `
          <tr>
            <td>${timeStr}</td>
            <td>${selectedTemp}</td>
            <td>${ml} ml</td>
            <td><span style="color: #10b981; font-weight:bold;">Completed</span></td>
          </tr>
        ` + tbody.innerHTML;

        document.getElementById("totalDispensedText").innerText = `${totalDispensedToday.toFixed(2)} L`;
        updateWaterUI();
      } else {
        alert("Not enough water in the gallon!");
      }
    }

    function requestRefill() {
      currentVolume = maxVolume;
      refillCount++;
      document.getElementById("refillCountText").innerText = refillCount;
      updateWaterUI();
      alert("Water gallon successfully replaced!");
    }

    function switchView(view) {
      document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.view-section').forEach(s => s.classList.remove('active'));

      if (view === 'dispenser') {
        event.target.classList.add('active');
        document.getElementById('dispenserView').classList.add('active');
      } else {
        event.target.classList.add('active');
        document.getElementById('adminView').classList.add('active');
      }
    }

    // Init
    updateWaterUI();
  </script>
</body>
</html>
